            }
          ]
        },
        "options": {}
      },
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        280,
        -160
      ],
      "id": "bf79015e-5d70-4d5d-bd4c-b665b25648df"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Requests"
        },
        "options": {}
      },
      "name": "Read the sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        520,
        160
      ],
      "id": "701fb996-84da-4eba-a94b-157e1f5f13f9",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Rows with a date in closed_at, not marked paid, whose next payment reminder is due.\n// Reminders are written in reply_label as \"pay_reminder_1 2026-10-14\", so the count and the last date live in the row.\nconst s = $('Settings').first().json;\nconst tz = s.timezone;\nconst now = DateTime.now().setZone(tz);\nconst parse = v => {\n  const t = String(v ?? '').trim();\n  if (!t) return null;\n  let d = DateTime.fromISO(t, { zone: tz });\n  if (!d.isValid) { const j = new Date(t); if (!isNaN(j)) d = DateTime.fromJSDate(j, { zone: tz }); }\n  return d.isValid ? d : null;\n};\n// Factory values never send anything to a customer.\nconst ready = String(s.business_name).trim() && String(s.business_name).trim() !== 'Your Business Name'\n  && String(s.payment_info).trim() && /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(s.owner_email).trim())\n  && !/@example\\.com$/i.test(String(s.owner_email).trim());\nif (!ready) return [];\n\nconst seen = new Set();\nconst out = [];\nfor (const i of $input.all()) {\n  const r = i.json;\n  if (!r.request_id) continue;\n  const label = String(r.reply_label || '');\n  if (/\\bpaid\\b/i.test(label) || /pay_failed/.test(label)) continue;\n  if (['lost', 'no_reply'].includes(String(r.status || '').trim())) continue;\n  const closed = parse(r.closed_at);\n  if (!closed) continue;\n  const done = [...label.matchAll(/pay_reminder_(\\d+) (\\d{4}-\\d{2}-\\d{2})/g)];\n  const count = done.length;\n  if (count >= Number(s.max_reminders)) continue;\n  const last = count ? parse(done[count - 1][2]) : null;\n  const due = last ? last.plus({ days: Number(s.repeat_after_days) }) : closed.plus({ days: Number(s.first_after_days) });\n  if (now < due.startOf('day')) continue;\n  const email = String(r.email || '').trim().toLowerCase();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) || seen.has(email)) continue;\n  seen.add(email);\n  out.push({ json: { request_id: r.request_id, name: r.name || '', email: String(r.email).trim(),\n    thread_id: String(r.thread_id || '').trim(), reply_label: label.trim(), quote_amount: String(r.quote_amount || '').trim(), count } });\n  if (out.length >= Number(s.max_per_run)) break;\n}\nreturn out;"
      },
      "name": "Pick unpaid jobs to remind",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
