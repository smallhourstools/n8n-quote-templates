    {
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/threads/{{ $json.thread_id }}?format=metadata&metadataHeaders=Subject&metadataHeaders=Message-ID&metadataHeaders=Message-Id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {}
      },
      "name": "Read the quote thread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        160
      ],
      "id": "04ac7025-4f1e-42e6-a4f6-70d1e76cd22c",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Writes the email: a reply in the quote's Gmail thread when it exists, a new email otherwise.\nconst s = $('Settings').first().json;\nconst row = $('Pick unpaid jobs to remind').item.json;\nconst msgs = Array.isArray($json.messages) ? $json.messages : [];\nconst header = (m, n) => {\n  const h = ((m.payload && m.payload.headers) || []).find(x => String(x.name).toLowerCase() === n.toLowerCase());\n  return h ? h.value : '';\n};\nconst inThread = msgs.length > 0;\nconst subject0 = inThread ? header(msgs[0], 'Subject') : '';\nconst subject = inThread && subject0\n  ? (/^re:/i.test(subject0) ? subject0 : 'Re: ' + subject0)\n  : 'Payment reminder from ' + s.business_name;\nconst ids = msgs.map(m => header(m, 'Message-ID')).filter(Boolean);\nconst amountText = row.quote_amount ? ' for ' + row.quote_amount : '';\nconst text = String(s.reminder_message).replace(/\\{name\\}/g, row.name || 'there')\n  .replace(/\\{amount_text\\}/g, amountText).replace(/\\{payment_info\\}/g, s.payment_info)\n  + '\\n\\n' + s.business_name;\nconst b64 = v => Buffer.from(v, 'utf8').toString('base64');\nconst lines = [\n  'To: ' + row.email,\n  'Subject: =?UTF-8?B?' + b64(subject) + '?=',\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=UTF-8',\n  'Content-Transfer-Encoding: base64',\n];\nif (ids.length) lines.push('In-Reply-To: ' + ids[ids.length - 1], 'References: ' + ids.join(' '));\nconst raw = Buffer.from(lines.join('\\r\\n') + '\\r\\n\\r\\n' + b64(text), 'utf8').toString('base64url');\nconst day = DateTime.now().setZone(s.timezone).toFormat('yyyy-MM-dd');\nconst join = tag => [row.reply_label, tag].filter(Boolean).join('; ');\nreturn { json: { request_id: row.request_id, email: row.email, raw,\n  thread_id: inThread ? row.thread_id : '', in_thread: inThread,\n  label_sent: join('pay_reminder_' + (row.count + 1) + ' ' + day), label_failed: join('pay_failed ' + day) } };",
        "mode": "runOnceForEachItem"
      },
      "name": "Write the payment reminder",
