            },
            {
              "id": "87af90ae-b4fe-4e5d-9700-d3cd45752ca1",
              "name": "repeat_after_days",
              "value": 7,
              "type": "number"
            },
            {
              "id": "8b7ad8eb-fb42-442c-9573-b6056fe53e3a",
              "name": "max_reminders",
              "value": 2,
              "type": "number"
            },
            {
              "id": "f8af45ac-712b-4e78-bd45-c497aa5b6274",
              "name": "max_per_run",
              "value": 10,
              "type": "number"
            },
            {
              "id": "257c084e-8fe7-4dea-b712-28494c3e4b49",
              "name": "timezone",
