      "name": "Read the sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        520,
        160
      ],
      "id": "93f6d456-c434-43cf-b799-d60ed9ab6d92",
      "alwaysOutputData": true
