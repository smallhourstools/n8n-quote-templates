    {
      "parameters": {
        "jsCode": "// Rows whose job is closed (closed_at filled) and that were never asked for a review.\n// Lost and no-reply quotes are never asked. The ask is written in reply_label, so a row is asked once, ever.\nconst s = $('Settings').first().json;\nconst tz = s.timezone;\nconst now = DateTime.now().setZone(tz);\nconst parse = v => {\n  const t = String(v ?? '').trim();\n  if (!t) return null;\n  let d = DateTime.fromISO(t, { zone: tz });\n  if (!d.isValid) { const j = new Date(t); if (!isNaN(j)) d = DateTime.fromJSDate(j, { zone: tz }); }\n  return d.isValid ? d : null;\n};\n// Factory values never send anything to a customer.\nconst ready = String(s.business_name).trim() && String(s.business_name).trim() !== 'Your Business Name'\n  && String(s.review_link).trim() && /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(s.owner_email).trim())\n  && !/@example\\.com$/i.test(String(s.owner_email).trim());\nif (!ready) return [];\n\nconst seen = new Set();\nconst out = [];\nfor (const i of $input.all()) {\n  const r = i.json;\n  if (!r.request_id) continue;\n  if (/review_(asked|failed)/.test(String(r.reply_label || ''))) continue;\n  if (['lost', 'no_reply'].includes(String(r.status || '').trim())) continue;\n  const closed = parse(r.closed_at);\n  if (!closed || now.diff(closed, 'days').days < Number(s.ask_after_days)) continue;\n  const start = parse(r.job_start);\n  if (start && start > now) continue;\n  const email = String(r.email || '').trim().toLowerCase();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) || seen.has(email)) continue;\n  seen.add(email);\n  out.push({ json: { request_id: r.request_id, name: r.name || '', email: String(r.email).trim(),\n    thread_id: String(r.thread_id || '').trim(), reply_label: String(r.reply_label || '').trim() } });\n  if (out.length >= Number(s.max_per_run)) break;\n}\nreturn out;"
      },
      "name": "Pick closed jobs to ask",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        160
      ],
      "id": "e9ab8a72-72cd-4efe-ad62-772bb3acaca2"
    },
